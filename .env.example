# Chat Memory — environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required: Google Gemini API key (free tier — gemini-2.0-flash or gemini-2.5-flash)
GEMINI_API_KEY=your-gemini-api-key-here

# Path where Chroma persists its on-disk vector store (inside the named Docker volume)
CHROMA_PERSIST_DIR=app/data/chroma

# Path to the SQLite deduplication database
SQLITE_PATH=app/data/dedup.db

# Hours of silence between messages before a new session chunk begins (default: 2)
SESSION_GAP_HOURS=2
