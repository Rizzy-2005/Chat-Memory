# Chat Memory — environment variables
# Copy this file to .env and fill in your values. Never commit .env.

# ── LLM ──────────────────────────────────────────────────────────────────────
# Gemini (primary). Free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Groq (optional fallback, used when Gemini is overloaded or out of quota).
# Free key: https://console.groq.com
GROQ_API_KEY=

# Models (defaults shown). Free-tier models get retired — if one stops working,
# pick a current one from Google AI Studio / the Groq console.
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest
# GROQ_MODEL=openai/gpt-oss-120b
# auto | gemini | groq
# LLM_PROVIDER=auto

# ── Storage (local runs; docker-compose overrides these to /data/...) ────────
CHROMA_PERSIST_DIR=app/data/chroma
SQLITE_PATH=app/data/dedup.db

# ── Ingestion ────────────────────────────────────────────────────────────────
# Hours of silence that start a new conversation session
SESSION_GAP_HOURS=2
# Longer sessions are split (MiniLM only reads ~256 word-pieces)
MAX_CHUNK_CHARS=1000
# auto | DMY | MDY — force it if your phone's dates are misread
# DATE_ORDER=auto

# ── Agent ────────────────────────────────────────────────────────────────────
# Tool-call rounds per question (protects free quotas)
# MAX_TOOL_ROUNDS=3
# Characters of chat text per LLM call; 0 = auto per model (Gemini 30k, Groq 12k)
# MAX_CONTEXT_CHARS=0

# ── Frontend ─────────────────────────────────────────────────────────────────
# BACKEND_URL=http://localhost:8000
