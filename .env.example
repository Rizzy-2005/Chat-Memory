# Chat Memory — environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required: Google Gemini API key — get one at aistudio.google.com/app/apikey
# The key must start with 'AIza' (not 'AQ.' which is an OAuth token, not an API key)
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Gemini model name (default: gemini-2.0-flash-lite)
# gemini-2.0-flash-lite  — higher free-tier RPM, good for development
# gemini-2.0-flash       — smarter, lower free-tier RPM
# gemini-1.5-flash       — alternative with separate quota bucket
GEMINI_MODEL=gemini-2.0-flash-lite

# Path where Chroma persists its on-disk vector store (inside the named Docker volume)
CHROMA_PERSIST_DIR=app/data/chroma

# Path to the SQLite deduplication database
SQLITE_PATH=app/data/dedup.db

# Hours of silence between messages before a new session chunk begins (default: 2)
SESSION_GAP_HOURS=2
